# ==============================================================================
# JobPulse AI - Backend Environment Configuration (.env.example)
# Copy this file to .env and configure your local settings.
# NEVER commit real credentials, API keys, or passwords to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Data Persistence Configuration
# Data is persisted automatically in local JSON files under ./data/ (no external database server required).
# DATA_DIR=./data

# ==============================================================================
# Job Discovery API Providers
# ==============================================================================
# Preferred India-first provider: Adzuna (Free registration at developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Active Job Provider: 'adzuna' or 'arbeitnow'
# Note: Remotive Public API is automatically integrated for worldwide remote listings.
JOB_PROVIDER=adzuna

# Demo Mode: 'true' enables synthetic sample jobs for offline testing; 'false' enforces live vacancies only.
DEMO_MODE=false

# ==============================================================================
# AI Matching Engine Configuration
# ==============================================================================
# Provider options:
# - 'demo': Built-in deterministic 5-factor scoring engine (no external API key required)
# - 'gemini': Google Gemini AI API
# - 'openai': OpenAI API
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# ==============================================================================
# Automated Email Notifications & Digest (SMTP)
# ==============================================================================
# For Gmail, generate a 16-character App Password at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_TO=

# ==============================================================================
# Background Automation Scheduler (node-cron & Vercel Cron)
# ==============================================================================
# Automatically runs daily job discovery, vacancy verification, and email alerts
SCHEDULER_ENABLED=true
SCHEDULER_DAILY_TIME=09:00
SCHEDULER_TIMEZONE=Asia/Kolkata
# Optional secret for securing Vercel Cron invocations (/api/scheduler/trigger)
CRON_SECRET=
