# ==============================================================================
# JobPulse AI - Root Environment Template (.env.example)
# To configure the backend, copy this file to server/.env and fill in values.
# NEVER commit .env files containing real secrets to version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Data Persistence Configuration
# Data is persisted automatically in local JSON files under ./data/ (no external database server required).
# DATA_DIR=./data

# ==============================================================================
# Job Discovery API Providers
# ==============================================================================
# Adzuna API (Register at developer.adzuna.com for free credentials)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Active Provider: 'adzuna' or 'arbeitnow'
JOB_PROVIDER=adzuna

# Demo Mode: 'true' enables synthetic sample jobs for offline test runs; 'false' enforces live vacancies only
DEMO_MODE=false

# ==============================================================================
# AI Matching Engine Configuration
# ==============================================================================
# 'demo' (built-in deterministic 5-factor engine, no key needed), 'gemini', or 'openai'
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1

# ==============================================================================
# Email Alerts Configuration (Nodemailer SMTP)
# ==============================================================================
# Note: For Gmail, enable 2FA and create a 16-character App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_TO=

# ==============================================================================
# Background Automation Scheduler (node-cron & Vercel Cron)
# ==============================================================================
SCHEDULER_ENABLED=true
SCHEDULER_DAILY_TIME=09:00
SCHEDULER_TIMEZONE=Asia/Kolkata
# Optional secret for securing Vercel Cron invocations (/api/scheduler/trigger)
CRON_SECRET=
