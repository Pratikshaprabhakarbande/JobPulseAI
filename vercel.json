{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite"
    },
    "jobpulseai": {
      "root": "server",
      "framework": "express",
      "buildCommand": "npm install --include=dev && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "jobpulseai"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/scheduler/trigger",
      "schedule": "30 3 * * *"
    }
  ]
}
