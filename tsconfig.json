{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "typeRoots": ["./server/node_modules/@types", "./node_modules/@types"],
    "types": ["node"]
  },
  "include": ["api/**/*", "server/src/**/*"],
  "exclude": ["node_modules", "client"]
}
